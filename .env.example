# ==============================================================================
# Zenith GymSoft Multi-Database Configuration
# ==============================================================================
PORT=5000

# ------------------------------------------------------------------------------
# OPTION 1: NEON DB / POSTGRESQL (Recommended for Vercel & Cloud)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# ------------------------------------------------------------------------------
# DATABASE_URL=postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-sweet-glade-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# OPTION 2: MYSQL (For Local / XAMPP / cPanel / Railway / Docker)
# Format: mysql://[user]:[password]@[host]:[port]/[database]
# ------------------------------------------------------------------------------
# DATABASE_URL=mysql://root:password@127.0.0.1:3306/gymsoft

# ------------------------------------------------------------------------------
# OPTION 3: SQLITE (Zero-setup local single-file database - default fallback)
# ------------------------------------------------------------------------------
DB_TYPE=sqlite
SQLITE_FILE=./gymsoft.db
